{
  "name": "@vben/web-antdv-next",
  "version": "5.7.0",
  "homepage": "https://vben.pro",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbenjs/vue-vben-admin.git",
    "directory": "apps/web-antdv-next"
  },
  "license": "MIT",
  "author": {
    "name": "vben",
    "email": "ann.vben@gmail.com",
    "url": "https://github.com/anncwb"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm vite build --mode production",
    "build:analyze": "pnpm vite build --mode analyze",
    "build:electron": "pnpm vite build --mode production --base=./ && electron-builder --win",
    "dev": "pnpm vite --mode development",
    "dev:electron": "electron ./electron/main.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@faker-js/faker": "catalog:",
    "@logicflow/core": "catalog:",
    "@logicflow/extension": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "@vben-core/composables": "workspace:*",
    "@vben-core/menu-ui": "workspace:*",
    "@vben/access": "workspace:*",
    "@vben/common-ui": "workspace:*",
    "@vben/constants": "workspace:*",
    "@vben/hooks": "workspace:*",
    "@vben/icons": "workspace:*",
    "@vben/layouts": "workspace:*",
    "@vben/locales": "workspace:*",
    "@vben/plugins": "workspace:*",
    "@vben/preferences": "workspace:*",
    "@vben/request": "workspace:*",
    "@vben/stores": "workspace:*",
    "@vben/styles": "workspace:*",
    "@vben/types": "workspace:*",
    "@vben/utils": "workspace:*",
    "@visactor/vtable": "catalog:",
    "@visactor/vtable-editors": "catalog:",
    "@visactor/vtable-gantt": "catalog:",
    "@vueuse/core": "catalog:",
    "antdv-next": "catalog:",
    "dayjs": "catalog:",
    "json-bigint": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vxe-pc-ui": "catalog:",
    "vxe-table": "catalog:"
  },
  "devDependencies": {
    "@types/json-bigint": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:"
  },
  "build": {
    "appId": "com.vben.webantdvnext",
    "beforeBuild": "./electron/before-build.mjs",
    "productName": "Web Antdv Next",
    "directories": {
      "app": "electron",
      "output": "dist-electron"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false
    }
  }
}
